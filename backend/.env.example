# Django
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# En local (hors Docker): localhost:5432
# Sous Docker Compose: remplacer localhost par 'postgres'


# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key

# LinkedIn OAuth
# Créer une app sur https://developer.linkedin.com/
# Mettre LINKEDIN_CLIENT_ID=mock pour simuler le flow en local sans app LinkedIn
LINKEDIN_CLIENT_ID=mock
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/posts/linkedin/callback/

# Chiffrement tokens OAuth
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
