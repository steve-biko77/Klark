# === BACKEND (voir backend/.env.example pour plus de détails) ===
SECRET_KEY=your_django_secret_key
DEBUG=True
# En local (hors Docker): postgresql://klark:klark_dev@localhost:5432/klark
# Avec Supabase: URL de connexion (pooler) depuis Project Settings > Database
DATABASE_URL=postgresql://user:password@host:5432/dbname
ANTHROPIC_API_KEY=your_anthropic_key

# === FRONTEND Next.js ===
NEXT_PUBLIC_API_URL=http://localhost:8000
